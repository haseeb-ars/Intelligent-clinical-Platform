GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here (legacy/optional)

# NeonDB — connection pooling URL (use this for Prisma in production)
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require

# NeonDB — direct connection URL (used for migrations)
DIRECT_URL=postgresql://user:password@ep-xxx-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=your_jwt_secret_here_change_in_production
PORT=3001
